ANTHROPIC_API_KEY=
SARVAM_API_KEY=
# Word timing, one of:
#   ELEVENLABS_API_KEY                               direct ElevenLabs forced alignment
#   CAPTIK_ALIGN_URL=.../clipper-align + CAPTIK_ALIGN_TOKEN   scoped proxy, alignment only (collaborators)
#   CAPTIK_ALIGN_URL=.../elevenlabs-align + SUPABASE_SERVICE_ROLE_KEY   Captik's own function (owner only)
ELEVENLABS_API_KEY=
CAPTIK_ALIGN_URL=https://fztigpslhgfqpxqscckb.supabase.co/functions/v1/clipper-align
CAPTIK_ALIGN_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
STT_MODEL=sarvam:saaras:v3
# B-roll library ingest reads PEXELS_API_KEY / PIXABAY_API_KEY from captik-graphics/.env.local (see TASKS.md §2)
# roman = Hinglish captions in Roman script (default) · native = keep Sarvam's Devanagari
CAPTION_SCRIPT=roman
# Only for STT_MODEL=whisper-large-v3 (Groq fallback)
GROQ_API_KEY=
# Only for `npm run sync:captik`: the captik-app checkout to copy templates, editor components and fonts from
CAPTIK_APP_DIR=../Captik/captik-app
PORT=4321
CURATOR_MODEL=claude-opus-5
CURATOR_FALLBACK_MODEL=claude-sonnet-5
CURATOR_EFFORT=high
SARVAM_INR_PER_HOUR=30
ELEVENLABS_ALIGN_USD_PER_HOUR=0.22
MAX_DOWNLOAD_HEIGHT=1080
# chrome | edge | firefox — only when Instagram/Facebook downloads need a logged-in session
YTDLP_COOKIES_FROM_BROWSER=
MAX_SOURCE_MINUTES=180
USD_INR=88
HOSTED_CPU_USD_PER_HOUR=0.357
RENDER_CONCURRENCY=2
