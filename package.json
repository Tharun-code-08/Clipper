{
  "name": "captik-clipper",
  "version": "0.1.0",
  "description": "Captik Clipper - LLM-curated viral shorts from long-form video",
  "main": "server.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch-path=server.js --watch-path=src --env-file-if-exists=.env server.js",
    "train": "node --env-file-if-exists=.env training/train.js",
    "build:editor": "npm run build",
    "sync:captik": "node scripts/sync-captik.mjs",
    "build": "vite build --config web/vite.config.mjs",
    "dev:web": "vite --config web/vite.config.mjs",
    "graphics:smoke": "node scripts/graphics-smoke.mjs"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@remotion/bundler": "4.0.470",
    "@remotion/media": "4.0.470",
    "@remotion/media-parser": "4.0.470",
    "@remotion/noise": "4.0.470",
    "@remotion/paths": "4.0.470",
    "@remotion/renderer": "4.0.470",
    "@remotion/shapes": "4.0.470",
    "@remotion/web-renderer": "4.0.470",
    "express": "^5.2.1",
    "framer-motion": "12.39.0",
    "lucide-react": "1.16.0",
    "multer": "^2.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "4.0.470"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
