+  return (
+    <div className="h-screen flex flex-col bg-zinc-950 text-white" data-testid="cutsfx-harness">
+      <div className="flex-1 min-h-0 flex">
+        <aside className="w-[260px] shrink-0 overflow-y-auto border-r border-white/10" data-testid="panel-autoedit">
+          <AutoEditTab
+            settings={autoEdit.settings}
+            setSettings={autoEdit.setSettings}
+            onRun={autoEdit.run}
+            running={autoEdit.running}
+            error={autoEdit.error}
+            notice={autoEdit.notice}
+            hasVideo
+            hasEdits={autoEdit.hasEdits}
+            savedSeconds={autoEdit.savedSeconds}
+            removed={autoEdit.result?.removed ?? []}
+            editMode={autoEdit.editMode}
+            onEditModeChange={autoEdit.setEditMode}
+            hoveredRemovedId={autoEdit.hoveredRemovedId}
+            onHover={autoEdit.setHoveredRemovedId}
+            onSeek={(sec) => seek(Math.round(sec * 1000))}
+            onRestore={autoEdit.restore}
+            onCutAgain={autoEdit.cutAgain}
+            onClear={autoEdit.clear}
+          />
+        </aside>
+        <main className="flex-1 min-w-0 flex">
+          <VideoCanvas
+            ref={canvas}
+            videoSrc="/test_video.mp4"
+            words={words}
+            phase="ready"
+            errMsg=""
+            dominantColor="#06b6d4"
+            accentColor="#06b6d4"
+            bleepRanges={[]}
+            captionStyle="hormozi"
+            captionSegments={segments}
+            durationMs={DURATION_MS}
+            onTimeUpdate={setCurrentTimeMs}
+            onPlayStateChange={setIsPlaying}
+            keepSegments={autoEdit.cutsApply ? autoEdit.keepSegments : null}
+            hasCuts={!!autoEdit.result?.removed.length}
+            editMode={autoEdit.editMode}
+            onEditModeChange={autoEdit.setEditMode}
+          />
+        </main>
+        <aside className="w-[260px] shrink-0 overflow-y-auto border-l border-white/10" data-testid="panel-sfx">
+          <SfxTab
+            sfx={sfx}
+            currentTimeMs={currentTimeMs}
+            durationMs={DURATION_MS}
+            onAdd={(s) => setSfx((list) => [...list, s].sort((a, b) => a.atMs - b.atMs))}
+            onUpdate={updateSfx}
+            onRemove={(id) => setSfx((list) => list.filter((s) => s.id !== id))}
+            selectedId={selectedSfxId}
+            onSelect={setSelectedSfxId}
+            onSeek={seek}
+            isCut={isCut}
+          />
+        </aside>
+      </div>
+      <div className="shrink-0 border-t border-white/10" data-testid="timeline">
+        <EditorTimeline
+          words={words}
+          captionSegments={segments}
+          selectedWordId={null}
+          isPlaying={isPlaying}
+          currentTimeMs={currentTimeMs}
+          durationMs={DURATION_MS}
+          onWordSelect={noop}
+          onPlayPause={() => canvas.current?.toggle()}
+          onSeek={seek}
+          onSegmentTimeChange={noop}
+          onEditStart={noop}
+          onUndo={noop}
+          onRedo={noop}
+          onDeleteSegments={noop}
+          canUndo={false}
+          canRedo={false}
+          segmentStyleOverrides={{}}
+          captionStyle="hormozi"
+          onSegmentStyleChange={noop}
+          removedRanges={autoEdit.activeRemoved}
+          removedMuted={autoEdit.editMode !== 'edited'}
+          sfxMarkers={sfx.map((s) => ({
+            id: s.id, atMs: s.atMs, label: sfxLabel(s.sfxId), selected: s.id === selectedSfxId, cut: isCut(s.atMs),
+          }))}
+          onSfxSelect={setSelectedSfxId}
+          onSfxMove={(id, atMs) => updateSfx(id, { atMs })}
+        />
+      </div>
+      <pre className="hidden" data-testid="harness-state">
+        {JSON.stringify({
+          keeps: autoEdit.cutsApply ? autoEdit.keepSegments.map((k) => [k.start, k.end]) : null,
+          removed: autoEdit.activeRemoved.map((r) => ({ reason: r.reason, start: r.start, end: r.end, detail: r.detail })),
+          sfx: sfx.map((s) => ({ sfxId: s.sfxId, atMs: s.atMs, gain: s.gain })),
+          currentTimeMs, isPlaying, editMode: autoEdit.editMode,
+        })}
+      </pre>
+    </div>
+  );
+}
