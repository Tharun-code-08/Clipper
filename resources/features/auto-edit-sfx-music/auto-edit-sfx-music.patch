+import { describe, it, expect } from 'vitest';
+import { buildSfxMixGraph, type MusicMixInput } from './sfxMix';
+import { duckVolumeExpr, duckWindows } from '@/lib/music/duck';
+
+const music = (patch: Partial<MusicMixInput> = {}): MusicMixInput => ({
+  startMs: 0,
+  volumeExpr: duckVolumeExpr(duckWindows([{ startMs: 1000, endMs: 1400 }]), 0.35, -14),
+  fadeInMs: 800,
+  fadeOutMs: 800,
+  durationMs: 30_000,
+  ...patch,
+});
+
+describe('buildSfxMixGraph', () => {
+  // The two assertions that predate music — kept verbatim so the exact graph stays pinned.
+  it('delays and scales each sound, then mixes without normalising the voice track down', () => {
+    const g = buildSfxMixGraph([{ atMs: 1500.4, gain: 0.8 }, { atMs: 0, gain: 9 }]);
+    expect(g).toContain('[1:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo[bed]');
+    expect(g).toContain('[2:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,volume=0.800,adelay=delays=1500:all=1[s0]');
+    expect(g).toContain('[3:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,volume=1.500,adelay=delays=0:all=1[s1]');
+    expect(g.endsWith('[bed][s0][s1]amix=inputs=3:duration=first:dropout_transition=0:normalize=0[aout]')).toBe(true);
+  });
+
+  it('honours custom input indices and survives junk numbers', () => {
+    const g = buildSfxMixGraph([{ atMs: Number.NaN, gain: Number.NaN }], 0, 5);
+    expect(g).toContain('[0:a]aresample');
+    expect(g).toContain('[5:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,volume=1.000,adelay=delays=0:all=1[s0]');
+  });
+
+  it('mixes the source bed with each sound at its own moment', () => {
+    const g = buildSfxMixGraph([{ atMs: 2000, gain: 0.8 }, { atMs: 5000, gain: 1 }]);
+    expect(g).toContain('[1:a]');
+    expect(g).toContain('adelay=delays=2000:all=1[s0]');
+    expect(g).toContain('adelay=delays=5000:all=1[s1]');
+    // normalize=0 — otherwise amix divides by the input count and the voice drops when a sound lands.
+    expect(g).toContain('amix=inputs=3:duration=first:dropout_transition=0:normalize=0[aout]');
+  });
+
+  it('is unchanged when there is no music', () => {
+    const plain = buildSfxMixGraph([{ atMs: 0, gain: 1 }]);
+    expect(buildSfxMixGraph([{ atMs: 0, gain: 1 }], 1, 2, null)).toBe(plain);
+    expect(plain).not.toContain('[mus]');
+  });
+
+  it('adds music as the last input, with the duck curve evaluated per frame', () => {
+    const g = buildSfxMixGraph([{ atMs: 2000, gain: 1 }], 1, 2, music());
+    expect(g).toContain('[3:a]');                    // source is 1, one sound is 2, music is 3
+    expect(g).toMatch(/volume='[^']+':eval=frame/);  // a curve, not a constant
+    expect(g).toContain('[mus]');
+    expect(g).toContain('amix=inputs=3');            // bed + sound + music
+  });
+
+  it('music alone still mixes over the bed', () => {
+    const g = buildSfxMixGraph([], 1, 2, music());
+    expect(g).toContain('[2:a]');
+    expect(g).toContain('amix=inputs=2');
+  });
+
+  it('a delayed track is delayed, and an undelayed one is not', () => {
+    expect(buildSfxMixGraph([], 1, 2, music({ startMs: 4500 }))).toContain('adelay=delays=4500:all=1');
+    expect(buildSfxMixGraph([], 1, 2, music({ startMs: 0 }))).not.toContain('adelay');
+  });
+
+  it('fades sit at the track start and at the end of the video', () => {
+    const g = buildSfxMixGraph([], 1, 2, music({ startMs: 2000, fadeInMs: 500, fadeOutMs: 1000, durationMs: 30_000 }));
+    expect(g).toContain('afade=t=in:st=2.000:d=0.500');
+    expect(g).toContain('afade=t=out:st=29.000:d=1.000');
+  });
+
+  it('no fades requested → none in the graph', () => {
+    const g = buildSfxMixGraph([], 1, 2, music({ fadeInMs: 0, fadeOutMs: 0 }));
+    expect(g).not.toContain('afade');
+  });
+});
diff --git a/src/lib/sfx/sfxMix.ts b/src/lib/sfx/sfxMix.ts
new file mode 100644
index 0000000..ffca4a8
--- /dev/null
+++ b/src/lib/sfx/sfxMix.ts
@@ -0,0 +1,62 @@
+// Pure ffmpeg filter graph that mixes placed sound effects over a source audio track. Used by the
+// Element Capture exporter's ffmpeg.wasm mux (its captured video carries no audio). No ffmpeg
+// import here, so the graph is unit-testable and can be checked against a real ffmpeg.
+
+export interface SfxMixInput {
+  /** Export-clock ms where the sound starts. */
+  atMs: number;
+  /** 0..1.5 */
+  gain: number;
+}
+
+/** Background music mixed under everything else, with the duck curve already computed. */
+export interface MusicMixInput {
+  /** Export-clock ms where the track starts. */
+  startMs: number;
+  /** An ffmpeg `volume` expression in `t` (see lib/music/duck duckVolumeExpr). */
+  volumeExpr: string;
+  fadeInMs: number;
+  fadeOutMs: number;
+  /** Export length, so the tail fade lands at the end of the video. */
+  durationMs: number;
+}
+
+/**
+ * `sourceInput` is the ffmpeg input index of the source (its first audio stream is the bed);
+ * sounds are inputs `firstSfxInput`, `firstSfxInput + 1`, … in `sfx` order. Output label [aout].
+ *
+ * Every stream is brought to 48 kHz stereo so amix never has to guess, each sound is delayed to
+ * its moment, and amix runs with normalize=0 — without that, amix divides by the input count and
+ * the whole voice track drops in level the moment one sound is added.
+ */
+export function buildSfxMixGraph(
+  sfx: readonly SfxMixInput[],
+  sourceInput = 1,
+  firstSfxInput = 2,
+  music?: MusicMixInput | null,
+): string {
+  const norm = 'aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo';
+  const parts = [`[${sourceInput}:a]${norm}[bed]`];
+  const labels = ['[bed]'];
+  sfx.forEach((s, i) => {
+    const delay = Math.max(0, Math.round(Number.isFinite(s.atMs) ? s.atMs : 0));
+    const gain = Math.max(0, Math.min(1.5, Number.isFinite(s.gain) ? s.gain : 1));
+    parts.push(`[${firstSfxInput + i}:a]${norm},volume=${gain.toFixed(3)},adelay=delays=${delay}:all=1[s${i}]`);
+    labels.push(`[s${i}]`);
+  });
+  if (music) {
+    // Music is the LAST input. eval=frame because the duck curve is a function of time; the fades
+    // are separate from it so a duck at the very start can't be mistaken for the opening fade.
+    const mi = firstSfxInput + sfx.length;
+    const delay = Math.max(0, Math.round(Number.isFinite(music.startMs) ? music.startMs : 0));
+    const fadeIn = Math.max(0, music.fadeInMs) / 1000;
+    const fadeOut = Math.max(0, music.fadeOutMs) / 1000;
+    const outStart = Math.max(0, music.durationMs / 1000 - fadeOut);
+    const fades = (fadeIn > 0 ? `,afade=t=in:st=${(delay / 1000).toFixed(3)}:d=${fadeIn.toFixed(3)}` : '')
+      + (fadeOut > 0 ? `,afade=t=out:st=${outStart.toFixed(3)}:d=${fadeOut.toFixed(3)}` : '');
+    parts.push(`[${mi}:a]${norm}${delay > 0 ? `,adelay=delays=${delay}:all=1` : ''},volume='${music.volumeExpr}':eval=frame${fades}[mus]`);
+    labels.push('[mus]');
+  }
+  parts.push(`${labels.join('')}amix=inputs=${labels.length}:duration=first:dropout_transition=0:normalize=0[aout]`);
+  return parts.join(';');
+}
diff --git a/src/lib/sfx/sfxPlayer.ts b/src/lib/sfx/sfxPlayer.ts
new file mode 100644
index 0000000..5dd1c07
--- /dev/null
+++ b/src/lib/sfx/sfxPlayer.ts
@@ -0,0 +1,95 @@
+'use client';
+
+// PREVIEW playback for placed sound effects. One lazy AudioContext, decoded buffers cached per
+// sound id. Exports do NOT use this — the Remotion compositions (and the in-browser mux) mix the
+// same SfxInstance list into the rendered audio.
+
+import { useEffect, useRef } from 'react';
+import type { SfxInstance } from '@/types/sfx';
+import { loadSfx, sfxReady, sfxUri } from './sfxLoader';
+
+let ctx: AudioContext | null = null;
+const buffers = new Map<string, Promise<AudioBuffer>>();
+
+function audioCtx(): AudioContext | null {
+  try {
+    ctx ??= new AudioContext();
+    if (ctx.state === 'suspended') void ctx.resume();
+    return ctx;
+  } catch {
+    return null; // SSR / blocked
+  }
+}
+
+function bufferFor(c: AudioContext, id: string): Promise<AudioBuffer> | null {
+  const uri = sfxUri(id);
+  if (!uri) return null;
+  let p = buffers.get(id);
+  if (!p) {
+    p = fetch(uri).then((r) => r.arrayBuffer()).then((ab) => c.decodeAudioData(ab));
+    p.catch(() => buffers.delete(id));
+    buffers.set(id, p);
+  }
+  return p;
+}
+
+/** Fire-and-forget. `delayMs` schedules on the audio clock (sample-accurate lookahead). Silently
+ *  no-ops when audio is blocked, the bank has not loaded, or the id is unknown. */
+export function playSfx(id: string, gain = 1, delayMs = 0): void {
+  const c = audioCtx();
+  if (!c) return;
+  const run = () => {
+    const p = bufferFor(c, id);
+    if (!p) return;
+    const startAt = c.currentTime + Math.max(0, delayMs) / 1000;
+    void p.then((buf) => {
+      const src = c.createBufferSource();
+      const g = c.createGain();
+      g.gain.value = Math.max(0, Math.min(1.5, gain));
+      src.buffer = buf;
+      src.connect(g).connect(c.destination);
+      src.start(Math.max(c.currentTime, startAt));
+    }).catch(() => { /* undecodable — stay silent */ });
+  };
+  if (sfxReady()) run();
+  else void loadSfx().then(run).catch(() => { /* chunk failed — stay silent */ });
+}
+
+const LOOKAHEAD_MS = 90;   // page time updates arrive every ~50ms; schedule a beat ahead
+const LATE_MS = 150;       // a sound whose moment passed longer ago than this is skipped
+const JUMP_MS = 400;       // bigger playhead moves are seeks/skips, which fire nothing
+
+/** Mount once where the preview clock lives. Fires each placed sound as the playhead reaches it
+ *  during playback, scheduled on the audio clock so it lands on its frame rather than up to one
+ *  UI tick late. Seeks (and Auto-Edit skips) fire nothing — pass only the AUDIBLE sounds. */
+export function usePlacedSfx(
+  sfx: readonly SfxInstance[] | undefined,
+  currentTimeMs: number,
+  active: boolean,
+): void {
+  useEffect(() => {
+    if (sfx?.length && !sfxReady()) void loadSfx().catch(() => { /* silence is a fine fallback */ });
+  }, [sfx]);
+
+  const prevRef = useRef(currentTimeMs);
+  const firedRef = useRef<Set<string>>(new Set());
+  useEffect(() => {
+    const prev = prevRef.current;
+    prevRef.current = currentTimeMs;
+    const list = sfx ?? [];
+    const dt = currentTimeMs - prev;
+    if (!active || dt < 0 || dt > JUMP_MS) {
+      // Paused, or the playhead jumped: re-arm everything still ahead, disarm everything behind.
+      firedRef.current = new Set(list.filter((s) => s.atMs <= currentTimeMs).map((s) => s.id));
+      return;
+    }
+    for (const s of list) {
+      if (firedRef.current.has(s.id)) continue;
+      const lead = s.atMs - currentTimeMs;
+      if (lead > LOOKAHEAD_MS) continue;
+      firedRef.current.add(s.id);
+      if (lead < -LATE_MS) continue;
+      playSfx(s.sfxId, s.gain, Math.max(0, lead));
+    }
+  }, [currentTimeMs, active, sfx]);
+}
