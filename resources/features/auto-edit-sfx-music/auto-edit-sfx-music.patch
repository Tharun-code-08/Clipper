+'use client';
+
+// DEV-ONLY (see page.tsx). Real components + real hooks, fixture transcript.
+
+import { useCallback, useMemo, useRef, useState } from 'react';
+import VideoCanvas, { type VideoCanvasHandle } from '@/components/editor/VideoCanvas';
+import EditorTimeline from '@/components/editor/EditorTimeline';
+import AutoEditTab from '@/components/editor/panel/AutoEditTab';
+import SfxTab from '@/components/editor/panel/SfxTab';
+import { useAutoEdit } from '@/lib/autoedit/useAutoEdit';
+import { sourceToCutMs } from '@/lib/autoedit/remap';
+import { usePlacedSfx } from '@/lib/sfx/sfxPlayer';
+import { sfxLabel } from '@/lib/sfx/sfxLibrary';
+import { clampSfxGain, type SfxInstance } from '@/types/sfx';
+import type { TranscriptWord } from '@/types/transcript';
+
+const DURATION_MS = 10_027;
+
+// A take with a leading pause, a filler between two half-pauses, a long gap, and a restarted line.
+const SCRIPT: (string | number)[] = [
+  700, 'hey', 'guys', 'aaj', 'hum', 'baat', 'karenge', 900,
+  'hey', 'guys', 'aaj', 'hum', 'baat', 'karenge', 'crypto', 'ke', 'baare', 'mein', 450,
+  'umm', 450, 'sabse', 'pehle', 1300, 'settings', 'kholo',
+];
+
+function fixtureWords(): TranscriptWord[] {
+  const out: TranscriptWord[] = [];
+  let t = 0;
+  for (const item of SCRIPT) {
+    if (typeof item === 'number') { t += item; continue; }
+    out.push({ id: `w${out.length}`, text: item, startMs: t, endMs: t + 280, styleOverride: {} });
+    t += 300;
+  }
+  return out;
+}
+
+const noop = () => {};
+
+export default function Harness() {
+  const words = useMemo(() => fixtureWords(), []);
+  const segments = useMemo(() => {
+    const segs: string[][] = [];
+    for (let i = 0; i < words.length; i += 3) segs.push(words.slice(i, i + 3).map((w) => w.id));
+    return segs;
+  }, [words]);
+  const canvas = useRef<VideoCanvasHandle>(null);
+  const [currentTimeMs, setCurrentTimeMs] = useState(0);
+  const [isPlaying, setIsPlaying] = useState(false);
+  const [sfx, setSfx] = useState<SfxInstance[]>([]);
+  const [selectedSfxId, setSelectedSfxId] = useState<string | null>(null);
+
+  const autoEdit = useAutoEdit(words, DURATION_MS);
+  const seek = useCallback((ms: number) => { canvas.current?.seekTo(ms); setCurrentTimeMs(ms); }, []);
