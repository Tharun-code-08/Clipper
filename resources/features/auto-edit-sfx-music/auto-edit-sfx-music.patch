+    setSfx((list) => list.map((s) => (s.id !== id ? s : {
+      ...s,
+      ...(patch.atMs !== undefined ? { atMs: Math.max(0, Math.round(patch.atMs)) } : {}),
+      ...(patch.gain !== undefined ? { gain: clampSfxGain(patch.gain) } : {}),
+    })).sort((a, b) => a.atMs - b.atMs));
+  }, []);
