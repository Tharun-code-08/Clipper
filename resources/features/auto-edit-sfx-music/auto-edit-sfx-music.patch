+      { id: 'sx_b', sfxId: 'boom', atMs: 2000.4, gain: 4 },
+      { id: 'sx_a', sfxId: 'pop', atMs: 100, gain: 0.5, label: 'x' },
+      { id: 'sx_c', sfxId: 'es_licensed_thing', atMs: 50, gain: 1 },
