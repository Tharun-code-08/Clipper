+const baseLook = (over: Partial<BrandLook> = {}): BrandLook => ({
+  captionTextColor: '#ffffff',
+  accentColor: '#06b6d4',
+  emphasisStyle: {},
+  templateSlots: {},
+  textOverrides: {},
+  font: { name: null, data: null, isCustom: false },
