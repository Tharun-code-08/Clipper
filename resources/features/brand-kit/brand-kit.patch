+        <button onClick={onCancel}
+          className="px-3 py-2 rounded-xl text-[10.5px] font-semibold text-zinc-500 hover:text-zinc-200 transition-colors cursor-pointer">
+          Cancel
+        </button>
+      </div>
+    </div>
+  );
+}
