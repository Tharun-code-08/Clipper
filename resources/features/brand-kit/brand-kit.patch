+            />
+          </div>
+        )}
+      </div>
+
+      {error && <p className="text-[10.5px] text-red-300">{error}</p>}
+
+      <div className="flex items-center gap-1.5 pt-1">
+        <button onClick={() => onSave({ ...draft, name: draft.name.trim() || 'My brand kit' })}
