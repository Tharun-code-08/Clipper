+    expect(rolesUsedByTemplate('captik')).toEqual(['text', 'highlight']);
+    expect(rolesUsedByTemplate('scribble')).toEqual(['text', 'highlight', 'secondary', 'box']);
+    expect(rolesUsedByTemplate('black_punch')).toEqual([]);
+  });
+});
