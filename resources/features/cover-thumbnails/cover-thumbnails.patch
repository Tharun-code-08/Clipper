new file mode 100644
index 0000000..add656a
--- /dev/null
+++ b/src/app/cover-test/page.tsx
@@ -0,0 +1,21 @@
+// DEV-ONLY harness for the Cover feature: mounts the real Cover UI (CoverPanel + CoverPreview +
+// useCoverEditor) over a public test video with fixture words, so it can be driven end-to-end without a
+// signed-in session or a paid transcription. 404s in production.
+//
+//   /cover-test?plan=free|pro[&clean=1][&src=/some_public_video.mp4]   → the Cover editor
+//   /cover-test?gallery=1                                               → every supported template as a cover
+
+import { notFound } from 'next/navigation';
+import CoverHarness from './CoverHarness';
+
+export default async function CoverTestPage({
+  searchParams,
+}: {
+  searchParams: Promise<Record<string, string | string[] | undefined>>;
+}) {
+  if (process.env.NODE_ENV === 'production') notFound();
+  const sp = await searchParams;
+  const plan = typeof sp.plan === 'string' ? sp.plan : 'free';
+  const src = typeof sp.src === 'string' && /^\/[\w./-]+\.(mp4|webm|mov)$/i.test(sp.src) ? sp.src : '/test_video.mp4';
+  return <CoverHarness plan={plan} projectClean={sp.clean === '1'} gallery={sp.gallery === '1'} src={src} />;
+}
