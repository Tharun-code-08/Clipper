+});
+
+describe('styles', () => {
+  it('excludes the html-in-canvas-mangled templates', () => {
+    for (const s of ['hormozi', 'captik_shadow', 'liquid_glass', 'illusion', 'editor_masala', 'aura', 'aura_helvetica', 'big_reveal', 'big_red']) {
