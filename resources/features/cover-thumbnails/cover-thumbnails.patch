@@ -0,0 +1,122 @@
+'use client';
+
+import { useCallback, useRef, useState } from 'react';
+import type { TranscriptWord } from '@/types/transcript';
+import CoverPanel from '@/components/editor/cover/CoverPanel';
+import CoverPreview from '@/components/editor/cover/CoverPreview';
+import CoverStage from '@/components/editor/cover/CoverStage';
+import { useCoverEditor } from '@/components/editor/cover/useCoverEditor';
+import { seekExact, drawVideoFrame } from '@/lib/cover/frameCapture';
+import { CAPTION_STYLES } from '@/lib/captionStyles';
+import { coverPreset, defaultCoverBox, defaultCoverFontScale, isCoverStyleSupported, type CoverSettings } from '@/lib/cover/coverLayout';
+
+const WORDS: TranscriptWord[] = ['Yeh', 'trick', 'koi', 'nahi', 'batata', 'aapko'].map((text, i) => ({
+  id: `w${i}`, text, startMs: i * 400, endMs: i * 400 + 380, styleOverride: {},
+}));
+const SEGMENTS = [['w0', 'w1', 'w2'], ['w3', 'w4', 'w5']];
+const HOOK = {
+  rewrittenScript: 'This one trick changes how you edit forever',
+  overlays: ['Nobody Tells You This', 'Stop Editing Like This', 'Try This Today'],
+};
+
+function Gallery() {
+  const styles = CAPTION_STYLES.filter(d => isCoverStyleSupported(d.id));
+  const preset = coverPreset('reel');
+  const scale = 0.16;
+  return (
+    <div className="p-4 grid gap-3" style={{ gridTemplateColumns: `repeat(auto-fill, minmax(${preset.width * scale}px, 1fr))` }}>
+      {styles.map(d => (
+        <div key={d.id} data-gallery-style={d.id} className="flex flex-col gap-1">
+          <div style={{ width: preset.width * scale, height: preset.height * scale, overflow: 'hidden' }}>
+            <div style={{ width: preset.width, height: preset.height, transform: `scale(${scale})`, transformOrigin: 'top left' }}>
+              <CoverStage
+                preset={preset} frameUrl={null} frameW={0} frameH={0} panX={0.5} panY={0.5} zoom={1}
+                text="Nobody Tells You This" styleId={d.id} box={defaultCoverBox('reel')} fontScale={defaultCoverFontScale('reel')}
+                accentColor="#facc15" textColor="#ffffff" watermarked={false}
+              />
+            </div>
+          </div>
+          <span className="text-[10px] text-zinc-400 font-mono">{d.id}</span>
+        </div>
+      ))}
+    </div>
+  );
+}
+
+export default function CoverHarness({ plan, projectClean, gallery, src }: {
+  plan: string; projectClean: boolean; gallery: boolean; src: string;
+}) {
+  const videoRef = useRef<HTMLVideoElement | null>(null);
+  const [durationMs, setDurationMs] = useState(0);
+  const [currentTimeMs, setCurrentTimeMs] = useState(0);
+  const [settings, setSettings] = useState<CoverSettings | null>(null);
+  const [paywall, setPaywall] = useState(false);
+  const [open, setOpen] = useState(false);
+
+  // Callback ref: metadata can load BEFORE hydration attaches onLoadedMetadata, which left the
+  // timeline's max at 1 ms (every scrub clamped to the first frame).
+  const attachVideo = useCallback((v: HTMLVideoElement | null) => {
+    videoRef.current = v;
+    if (!v) return;
+    const read = () => { if (Number.isFinite(v.duration)) setDurationMs(v.duration * 1000); };
+    if (v.readyState >= 1) read();
+    else v.addEventListener('loadedmetadata', read, { once: true });
+  }, []);
+
+  const liveCapture = useCallback(async (t: number) => {
+    const v = videoRef.current;
+    if (!v) throw new Error('no-video');
+    v.pause();
+    await seekExact(v, t);
+    const canvas = drawVideoFrame(v);
+    setCurrentTimeMs(v.currentTime * 1000);
+    return canvas;
+  }, []);
+
+  const editor = useCoverEditor({
+    open, settings, onSettingsChange: setSettings, videoSrc: src, currentTimeMs, isPlaying: false,
+    liveCapture, hook: HOOK, words: WORDS, segments: SEGMENTS, projectStyle: 'mrbeast',
+    accentColor: '#facc15', textColor: '#ffffff', plan, projectClean, entitlementReady: true,
+    fileBase: src.split('/').pop(), onWatermarkedDownload: () => setPaywall(true),
+  });
+
+  if (gallery) return <div className="min-h-screen bg-[#0B0B0D]"><Gallery /></div>;
+
+  return (
+    <div className="flex flex-col h-screen bg-[#0B0B0D] text-white">
+      <div className="flex items-center gap-3 px-4 h-10 border-b border-white/10 text-xs shrink-0">
+        <span className="font-bold">Cover harness (dev only)</span>
+        <span className="text-zinc-400">plan: {plan}{projectClean ? ' + project unlock' : ''}</span>
+        <button data-testid="open-cover" onClick={() => setOpen(o => !o)} className="rounded bg-amber-500/20 px-2 py-1 cursor-pointer">
+          {open ? 'Close Cover' : 'Open Cover'}
+        </button>
+        {paywall && <span data-testid="paywall-opened" className="text-amber-300">Paywall opened (watermark)</span>}
+        <span data-testid="settings-json" className="hidden">{JSON.stringify(settings)}</span>
+        <span data-testid="duration-ms" className="hidden">{Math.round(durationMs)}</span>
+      </div>
+      <div className="flex flex-1 min-h-0">
+        <aside style={{ width: 260 }} className="shrink-0 overflow-y-auto border-r border-white/10 bg-zinc-900/50">
+          {open ? <CoverPanel editor={editor} hookOverlays={HOOK.overlays} currentTimeMs={currentTimeMs} /> : <p className="p-3 text-xs text-zinc-500">Cover closed</p>}
+        </aside>
+        {/* Mirrors the editor: the player stays mounted but hidden while Cover is open. */}
+        <div className={open ? 'hidden' : 'flex-1 flex items-center justify-center min-w-0'}>
+          <video ref={attachVideo} src={src} muted playsInline preload="auto" style={{ maxHeight: '100%', maxWidth: '100%' }} />
+        </div>
+        {open && <CoverPreview editor={editor} />}
+      </div>
+      <div className="h-12 px-4 flex items-center gap-3 border-t border-white/10 shrink-0">
+        <input
+          data-testid="scrub" type="range" min={0} max={Math.max(1, Math.round(durationMs))} step={1}
+          value={Math.round(currentTimeMs)} aria-label="Timeline"
+          onChange={(e) => {
+            const t = Number(e.target.value);
+            setCurrentTimeMs(t);
+            if (videoRef.current) videoRef.current.currentTime = t / 1000;
+          }}
+          className="flex-1"
+        />
+        <span className="font-mono text-xs">{(currentTimeMs / 1000).toFixed(2)}s</span>
+      </div>
+    </div>
+  );
+}
