+        const ws = b.wordIds.map((id) => byId.get(id)).filter((w): w is W => !!w);
+        const hero = byId.get(b.heroId);
+        if (!hero) return null;
+        const hi = ws.findIndex((w) => w.id === hero.id);
+        const pick = (ids: string[]) => ids.map((id) => byId.get(id)).filter((w): w is W => !!w);
