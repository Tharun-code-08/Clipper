+    expect(beats.map((b) => b.accent)).toEqual(beats.map((_, i) => DIMENSION_ACCENTS[i % DIMENSION_ACCENTS.length]));
+    const heroes = beats.map((b) => ws.find((w) => w.id === b.heroId)!.text);
+    expect(heroes).not.toContain('a');
