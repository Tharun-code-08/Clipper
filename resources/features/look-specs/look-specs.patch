+              </div>
+            )}
+            {(!layer || layer === b.plane) && (
+              <ReelInk mode="inception" accent={b.accent} dimensional width={width} fontSize={H} numberValue={/^\d+$/.test(hero.text) ? Number(hero.text) : undefined}
