+        const V = Math.min(cap, Math.max(24 * z, (X - 0.25 * H - q - 0.0125 * height) / 1.1), ...[[], ...groups].map((g) => fitPropertyHeadline([...all, ...g], { ...plain, weight: 700 }, cap, 0.84 * width)));
